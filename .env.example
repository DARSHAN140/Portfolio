# Copie ce fichier en .env.local pour le développement (NE JAMAIS commiter .env.local)
# En production : Vercel > Project > Settings > Environment Variables

# URL publique du site (sans / final)
NEXT_PUBLIC_SITE_URL=https://ton-portfolio.vercel.app

# Formulaire de contact (https://resend.com > API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=boutoukouaxel@gmail.com
# Optionnel : expéditeur sur ton domaine vérifié dans Resend (sinon onboarding@resend.dev)
# CONTACT_FROM_EMAIL=Portfolio <contact@ton-domaine.dev>

# Optionnel mais recommandé en prod : limitation de débit partagée (Upstash Redis, offre gratuite)
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxx

# Optionnel : API de modèle réelle derrière le proxy sécurisé /api/demo/credit-scoring
# DEMO_CREDIT_API_URL=https://ton-api.onrender.com/predict
# DEMO_API_TOKEN=une-longue-chaine-aleatoire

# Théorème CAP : si Redis est en panne -> "open" (disponibilité, AP, par défaut) ou "closed" (cohérence, CP)
# RATE_LIMIT_FAILURE_MODE=open
